# =============================================================
# COPY THIS FILE: rename it to .env.local and fill in your keys
# =============================================================
# Lines starting with # are notes — leave them, they don't do anything
# Replace everything that says PASTE_YOUR_... with your actual key
# =============================================================


# -------------------------------------------------------------
# YOUR LOGIN PASSWORD
# Make up any password you want — this is what you type at the
# login screen when you open the dashboard
# -------------------------------------------------------------
ADMIN_PASSWORD=PASTE_YOUR_OWN_PASSWORD_HERE


# -------------------------------------------------------------
# CRON SECRET
# Make up any random string of letters and numbers (e.g. abc123xyz789)
# This protects your automation endpoints from strangers calling them
# -------------------------------------------------------------
CRON_SECRET=PASTE_ANY_RANDOM_STRING_HERE


# -------------------------------------------------------------
# DATABASE — Turso (free tier is fine to start)
# 1. Go to turso.tech and sign up
# 2. Click "Create Database"
# 3. Copy the "libsql://..." URL into TURSO_DATABASE_URL
# 4. Go to your database → Tokens → Create token → paste below
# -------------------------------------------------------------
TURSO_DATABASE_URL=libsql://PASTE_YOUR_DB_URL_HERE.turso.io
TURSO_AUTH_TOKEN=PASTE_YOUR_TURSO_TOKEN_HERE


# -------------------------------------------------------------
# OPENAI — Required. Powers image generation + moderation
# 1. Go to platform.openai.com/api-keys
# 2. Click "Create new secret key"
# 3. Copy the sk-... key below
# -------------------------------------------------------------
OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE


# -------------------------------------------------------------
# ANTHROPIC — Highly recommended. Makes listing copy much better
# 1. Go to console.anthropic.com
# 2. Click "API Keys" → "Create Key"
# 3. Copy the sk-ant-... key below
# App works without this but copy quality will be lower
# -------------------------------------------------------------
ANTHROPIC_API_KEY=PASTE_YOUR_ANTHROPIC_KEY_HERE


# -------------------------------------------------------------
# REPLICATE — Highly recommended. Much better images than DALL-E
# 1. Go to replicate.com and sign up
# 2. Click your profile → "API Tokens" → "Create token"
# 3. Copy the r8_... token below
# App works without this but falls back to DALL-E 3
# -------------------------------------------------------------
REPLICATE_API_TOKEN=PASTE_YOUR_REPLICATE_TOKEN_HERE


# -------------------------------------------------------------
# PLACEIT — Lifestyle mockups (big CTR boost on Etsy)
# 1. Go to placeit.net and sign up for an API plan
# 2. Get your API token from their developer dashboard
# App works without this — uses flat Printify shots as fallback
# -------------------------------------------------------------
PLACEIT_API_TOKEN=PASTE_YOUR_PLACEIT_TOKEN_HERE


# -------------------------------------------------------------
# PRINTIFY — Required. This prints and ships your products
# 1. Go to printify.com and create an account
# 2. Go to My Account → Connections → API → Generate token
# 3. For SHOP ID: go to My Stores → click your store → look at the URL number
# -------------------------------------------------------------
PRINTIFY_API_TOKEN=PASTE_YOUR_PRINTIFY_TOKEN_HERE
PRINTIFY_SHOP_ID=PASTE_YOUR_PRINTIFY_SHOP_ID_HERE


# -------------------------------------------------------------
# ETSY — Required. Where your products get listed and sold
# 1. Go to developers.etsy.com and sign in
# 2. Click "Create a New App" and fill in the form
# 3. Your CLIENT_ID is called "Keystring" on the app page
# 4. Your CLIENT_SECRET is called "Shared Secret"
# 5. For REFRESH_TOKEN: follow Etsy's OAuth 2.0 guide to get one
# 6. For SHOP_ID: go to your Etsy shop page — it's the number in the URL
# -------------------------------------------------------------
ETSY_CLIENT_ID=PASTE_YOUR_ETSY_CLIENT_ID_HERE
ETSY_CLIENT_SECRET=PASTE_YOUR_ETSY_CLIENT_SECRET_HERE
ETSY_REFRESH_TOKEN=PASTE_YOUR_ETSY_REFRESH_TOKEN_HERE
ETSY_SHOP_ID=PASTE_YOUR_ETSY_SHOP_ID_HERE


# -------------------------------------------------------------
# VERCEL BLOB — Required. Stores your generated images permanently
# 1. Go to vercel.com and sign up (free)
# 2. Create a new project (can be empty)
# 3. Go to Storage tab → Blob → Create a Blob Store
# 4. Copy the BLOB_READ_WRITE_TOKEN it gives you
# -------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=PASTE_YOUR_VERCEL_BLOB_TOKEN_HERE


# -------------------------------------------------------------
# TREND RESEARCH APIs — Highly recommended for niche discovery
# Without these the app can only use AI-guessed trends
#
# PODCS: go to podcs.com → sign up → API section → get key
# Flying Research: go to flyingresearch.net → sign up → API → get key
# -------------------------------------------------------------
PODCS_API_KEY=PASTE_YOUR_PODCS_KEY_HERE
FLYING_RESEARCH_API_KEY=PASTE_YOUR_FLYING_RESEARCH_KEY_HERE


# =============================================================
# EXTRA PLATFORMS — Only fill in the ones you actually sell on
# Leave the others as-is, the app ignores blank optional keys
# =============================================================


# -------------------------------------------------------------
# SHOPIFY (optional)
# 1. Shopify admin → Settings → Apps and sales channels
# 2. Develop apps → Create an app → Admin API access token
# 3. STORE_URL is just yourstore.myshopify.com
# -------------------------------------------------------------
SHOPIFY_STORE_URL=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=PASTE_YOUR_SHOPIFY_TOKEN_HERE


# -------------------------------------------------------------
# TIKTOK SHOP (optional)
# 1. Go to seller.tiktok.com → Developer → Create app
# 2. Copy App Key, App Secret, and complete OAuth for Access Token
# -------------------------------------------------------------
TIKTOK_SHOP_APP_KEY=PASTE_YOUR_TIKTOK_APP_KEY_HERE
TIKTOK_SHOP_APP_SECRET=PASTE_YOUR_TIKTOK_APP_SECRET_HERE
TIKTOK_SHOP_ACCESS_TOKEN=PASTE_YOUR_TIKTOK_ACCESS_TOKEN_HERE


# -------------------------------------------------------------
# DEPOP (optional)
# 1. Go to developers.depop.com → Register your app
# 2. Complete their OAuth flow to get your access token
# -------------------------------------------------------------
DEPOP_CLIENT_ID=PASTE_YOUR_DEPOP_CLIENT_ID_HERE
DEPOP_CLIENT_SECRET=PASTE_YOUR_DEPOP_CLIENT_SECRET_HERE
DEPOP_ACCESS_TOKEN=PASTE_YOUR_DEPOP_ACCESS_TOKEN_HERE


# -------------------------------------------------------------
# REDBUBBLE (optional — invite only API program)
# 1. Apply at redbubble.com/api
# 2. Once accepted you'll get your API key and account ID
# -------------------------------------------------------------
REDBUBBLE_API_KEY=PASTE_YOUR_REDBUBBLE_KEY_HERE
REDBUBBLE_ACCOUNT_ID=PASTE_YOUR_REDBUBBLE_ACCOUNT_ID_HERE


# -------------------------------------------------------------
# AMAZON (optional — complex setup, do this last)
# 1. Sign up for Amazon Seller Central
# 2. Go to Apps & Services → Develop Apps → Register app
# 3. Complete SP-API OAuth to get your refresh token
# 4. MARKETPLACE_ID for USA is already filled in below
# -------------------------------------------------------------
AMAZON_SELLER_ID=PASTE_YOUR_AMAZON_SELLER_ID_HERE
AMAZON_MWS_ACCESS_KEY=PASTE_YOUR_AMAZON_ACCESS_KEY_HERE
AMAZON_MWS_SECRET_KEY=PASTE_YOUR_AMAZON_SECRET_KEY_HERE
AMAZON_REFRESH_TOKEN=PASTE_YOUR_AMAZON_REFRESH_TOKEN_HERE
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
