# Database (Turso - libSQL)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# OpenAI (GPT-4.1 + GPT-4o Vision + Moderation)
OPENAI_API_KEY=sk-your-openai-key

# Anthropic (Claude — creative text, listing copy, concepts)
# Optional: falls back to OpenAI if not set
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Replicate (Flux 1.1 Pro Ultra — image generation)
# Optional: falls back to DALL-E 3 if not set
REPLICATE_API_TOKEN=r8_your-replicate-token

# Printify
PRINTIFY_API_TOKEN=your-printify-token
PRINTIFY_SHOP_ID=your-printify-shop-id

# Etsy (OAuth 2.0)
ETSY_CLIENT_ID=your-etsy-client-id
ETSY_CLIENT_SECRET=your-etsy-client-secret
ETSY_REFRESH_TOKEN=your-etsy-refresh-token
ETSY_SHOP_ID=your-etsy-shop-id

# Shopify (optional — enables Shopify storefront publishing)
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxx

# TikTok Shop (optional — enables TikTok Shop publishing)
TIKTOK_SHOP_APP_KEY=your-app-key
TIKTOK_SHOP_APP_SECRET=your-app-secret
TIKTOK_SHOP_ACCESS_TOKEN=your-access-token

# Depop (optional — enables Depop publishing)
DEPOP_CLIENT_ID=your-client-id
DEPOP_CLIENT_SECRET=your-client-secret
DEPOP_ACCESS_TOKEN=your-access-token

# Redbubble (optional — enables Redbubble design uploads)
REDBUBBLE_API_KEY=your-api-key
REDBUBBLE_ACCOUNT_ID=your-account-id

# Amazon SP-API (optional — enables Amazon publishing)
AMAZON_SELLER_ID=your-seller-id
AMAZON_MWS_ACCESS_KEY=your-access-key
AMAZON_MWS_SECRET_KEY=your-secret-key
AMAZON_REFRESH_TOKEN=your-refresh-token
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER

# Trend Research APIs
PODCS_API_KEY=your-podcs-key
FLYING_RESEARCH_API_KEY=your-flying-research-key

# App
ADMIN_PASSWORD=your-secure-dashboard-password
CRON_SECRET=your-cron-secret-for-vercel

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
